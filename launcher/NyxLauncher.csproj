<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NyxLauncher</RootNamespace>
    <AssemblyName>nyx</AssemblyName>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The kernel travels inside the launcher, so the release is one file.
         It is the flat image rather than the ELF: no multiboot loader
         will accept a 64-bit ELF, and QEMU's -kernel is one. -->
    <EmbeddedResource Include="..\build\nyx.bin" Link="nyx.bin" />
  </ItemGroup>

</Project>
